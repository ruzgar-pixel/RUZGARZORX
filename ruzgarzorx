local okP, errP = pcall(function()
	local pl = page("Oyuncular")

	local cWatch = card(pl, "İZLEME")
	local stopBtn = new("TextButton", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = PUR, Text = "İzlemeyi bırak",
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = WHITE, BorderSizePixel = 0 }, cWatch)
	round(stopBtn, 6)
	stopBtn.Activated:Connect(stopWatch)

	local listCard = card(pl, "OYUNCULAR")
	local empty = txt(listCard, "Sunucuda başka oyuncu yok", UDim2.new(1, 0, 0, 24))
	empty.TextColor3 = GRAY

	local function mini(parent, text, x)
		local b = new("TextButton", { Size = UDim2.new(0, 58, 0, 26), Position = UDim2.new(1, x, .5, -13), BackgroundColor3 = PUR,
			Text = text, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WHITE, BorderSizePixel = 0 }, parent)
		round(b, 6)
		return b
	end

	local function refresh()
		for _, c in listCard:GetChildren() do
			if c.Name == "Row" then c:Destroy() end
		end
		local any = false
		for _, p in Players:GetPlayers() do
			if p ~= lp then
				any = true
				local row = new("Frame", { Name = "Row", Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = PAN, BorderSizePixel = 0 }, listCard)
				round(row, 6)
				local nm = txt(row, p.DisplayName, UDim2.new(1, -140, 1, 0), UDim2.new(0, 10, 0, 0))
				nm.TextTruncate = Enum.TextTruncate.AtEnd

				local tp = mini(row, "Işınlan", -128)
				tp.Activated:Connect(function()
					local target = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					local _, me = parts()
					if target and me then me.CFrame = target.CFrame * CFrame.new(0, 0, 3) end
				end)

				local wb = mini(row, "İzle", -66)
				wb.Activated:Connect(function()
					local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
					if hum then
						watching = p
						cam.CameraType = Enum.CameraType.Custom
						cam.CameraSubject = hum
					end
				end)
			end
		end
		empty.Visible = not any
	end
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(function(p)
		if watching == p then stopWatch() end
		task.defer(refresh)
	end)
	refresh()

	-- İzlenen oyuncu yeniden doğarsa kamera takip etsin
	RS.RenderStepped:Connect(function()
		if not watching then return end
		local hum = watching.Character and watching.Character:FindFirstChildOfClass("Humanoid")
		if hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
	end)

	-- Kendimiz yeniden doğunca izleme biter
	lp.CharacterAdded:Connect(function()
		task.wait(.2)
		stopWatch()
	end)
end)
