local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in props do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function txt(parent, text, size, pos, bold)
	return new("TextLabel", { BackgroundTransparency = 1, Size = size, Position = pos or UDim2.new(), Text = text,
		Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham, TextColor3 = WHITE, TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left }, parent)
end
local function parts()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

local function snd(id, vol, speed)
	local ok, s = pcall(function()
		local x = new("Sound", { SoundId = id, Volume = vol or .6, PlaybackSpeed = speed or 1 }, SoundService)
		x:Play()
		task.delay(6, function() x:Destroy() end)
		return x
	end)
	return ok and s or nil
end

