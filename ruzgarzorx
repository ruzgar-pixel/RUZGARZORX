-- Hava yürüme zemini: X/Z'de seninle gelir, Y'yi Space/Ctrl ile değiştirirsin
RS.RenderStepped:Connect(function(dt)
	if not S.airOn or not airPlat or not airY then return end
	local hum, root = parts()
	if not hum or not root then return end
	if UIS:IsKeyDown(Enum.KeyCode.Space) or up or hum.Jump then airY += 25 * dt end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or down then airY -= 25 * dt end
	airPlat.CFrame = CFrame.new(root.Position.X, airY, root.Position.Z)
end)

-- Ana döngü (hız, zıplama, uçma)
RS.RenderStepped:Connect(function()
	local hum, root = parts()
	if not hum or not root then return end
	if S.speedOn then hum.WalkSpeed = S.speed end
	if S.jumpOn then hum.UseJumpPower = true; hum.JumpPower = S.jump end
	if not S.flyOn then return end

	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	local dir = hum.MoveDirection
	local moving = dir.Magnitude > 0
	if moving and flat.Magnitude > .01 then dir += Vector3.yAxis * (dir:Dot(flat.Unit) * look.Y / flat.Magnitude) end
	if UIS:IsKeyDown(Enum.KeyCode.Space) or up then dir += Vector3.yAxis end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or down then dir -= Vector3.yAxis end
	root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * S.flySpeed or Vector3.zero

	local pos = root.Position
	local target
	if moving and flat.Magnitude > .01 then
		target = CFrame.lookAt(pos, pos + look) * CFrame.Angles(math.rad(-90), 0, 0)
	elseif flat.Magnitude > .01 then
		target = CFrame.lookAt(pos, pos + flat)
	end
	if target then root.CFrame = root.CFrame:Lerp(target, .2) end
end)

