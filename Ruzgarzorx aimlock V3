aimBtn.TextColor3 = THEME.Text
aimBtn.TextSize = math.floor(cfg.BtnSize * 0.3)
aimBtn.Visible = cfg.ShowAimBtn
aimBtn.Parent = aimGui
Instance.new("UICorner", aimBtn).CornerRadius = UDim.new(1, 0)

local aimStroke = Instance.new("UIStroke")
aimStroke.Color = THEME.Accent
aimStroke.Thickness = 3
aimStroke.Parent = aimBtn

local function refreshAimBtn()
	aimBtn.Visible = cfg.ShowAimBtn
	local sz = cfg.BtnSize
	aimBtn.Size = UDim2.fromOffset(sz, sz)
	aimBtn.TextSize = math.max(10, math.floor(sz * 0.3))
	if not cfg.BtnLocked then
		-- sürükleme modu: soluk görünür
		aimBtn.BackgroundColor3 = THEME.Panel
		aimBtn.BackgroundTransparency = 0.5
		aimBtn.TextColor3 = THEME.TextDim
		aimStroke.Color = THEME.TextDim
	elseif aiming then
		aimBtn.BackgroundColor3 = THEME.Accent
		aimBtn.BackgroundTransparency = 0.15
		aimBtn.TextColor3 = Color3.new(1, 1, 1)
		aimStroke.Color = Color3.new(1, 1, 1)
	else
		aimBtn.BackgroundColor3 = THEME.Panel
		aimBtn.BackgroundTransparency = 0.25
		aimBtn.TextColor3 = THEME.Text
		aimStroke.Color = THEME.Accent
	end
end

task.spawn(function()
	while true do
		task.wait(0.1)
		refreshAimBtn()
	end
end)

-- Basma / sürükleme
local btnDrag, btnInput, btnDragStart, btnStartPos = false, nil, nil, nil
local btnHeld = false

aimBtn.InputBegan:Connect(function(input)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	btnInput = input

	if cfg.BtnLocked then
		-- sabit: aim butonu gibi çalışır
		btnHeld = true
		if cfg.HoldToAim then
			aiming = true
		else
			aiming = not aiming
			notify(aiming and L("NotifyOn") or L("NotifyOff"))
		end
	else
		-- sabit değil: sürükleyerek taşı
		btnDrag = true
		btnDragStart = input.Position
		btnStartPos = aimBtn.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not btnDrag then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input == btnInput then
		local delta = input.Position - btnDragStart
		local vs = cam.ViewportSize
		aimBtn.Position = UDim2.fromOffset(
			math.clamp(btnStartPos.X.Offset + delta.X, 0, vs.X),
			math.clamp(btnStartPos.Y.Offset + delta.Y, 0, vs.Y)
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
	if not btnInput then return end
	if input == btnInput or (t == Enum.UserInputType.MouseButton1 and btnInput.UserInputType == Enum.UserInputType.MouseButton1) then
		if btnHeld and cfg.HoldToAim then aiming = false end
		btnHeld = false
		btnDrag = false
		btnInput = nil
	end
end)

