UserInputService.InputBegan:Connect(function(i, processed)
	if processed then return end
	if i.UserInputType == cfg.AimKey then
		if cfg.HoldToAim then aiming = true end
	elseif i.KeyCode == cfg.ToggleKey and not cfg.HoldToAim then
		aiming = not aiming
		notify(aiming and L("NotifyOn") or L("NotifyOff"))
	end
end)

UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType == cfg.AimKey and cfg.HoldToAim then
		aiming = false
	end
end)

