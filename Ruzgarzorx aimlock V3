----------------------------------------------------------------
-- ESP (Sadece parlama, kutu yok)
----------------------------------------------------------------
local function createEsp(plr)
	if plr == lp then return end
	if not plr.Character then return end

	local ch = plr.Character
	local existing = ch:FindFirstChild("RzEspGlow")
	if existing then existing:Destroy() end

	local hl = Instance.new("Highlight")
	hl.Name = "RzEspGlow"
	hl.FillColor = THEME.Neon
	hl.OutlineColor = THEME.Neon
	hl.FillTransparency = 0.4
	hl.OutlineTransparency = 0
	hl.Parent = ch

	espHighlights[plr] = hl
end

local function removeEsp(plr)
	if espHighlights[plr] then
		espHighlights[plr]:Destroy()
		espHighlights[plr] = nil
	end
	if plr.Character then
		local hl = plr.Character:FindFirstChild("RzEspGlow")
		if hl then hl:Destroy() end
	end
end

local function clearAllEsp()
	for plr, hl in pairs(espHighlights) do
		if hl then hl:Destroy() end
	end
	espHighlights = {}
end

local function updateEsp()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			if cfg.Esp then
				if not (cfg.TeamCheck and plr.Team and plr.Team == lp.Team) then
					local cur = espHighlights[plr]
					if (not cur or cur.Parent ~= plr.Character) and plr.Character then
						createEsp(plr)
					end
				else
					removeEsp(plr)
				end
			else
				removeEsp(plr)
			end
		end
	end

	for plr, hl in pairs(espHighlights) do
		if not plr.Parent then
			if hl then hl:Destroy() end
			espHighlights[plr] = nil
		end
	end
end

----------------------------------------------------------------
-- HEDAF
----------------------------------------------------------------
local function isVisible(part)
	local origin = cam.CFrame.Position
	local ign = { part.Parent, cam }
	if lp.Character then table.insert(ign, lp.Character) end

	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.RespectCanCollide = true -- CanCollide kapalı parçalar (görünmez duvar, tetikleyici vs.) engel sayılmaz
	p.IgnoreWater = true

	-- Neredeyse şeffaf parçaları da atla (en fazla 6 kez)
	for _ = 1, 6 do
		p.FilterDescendantsInstances = ign
		local hit = WS:Raycast(origin, part.Position - origin, p)
		if not hit then return true end
		if hit.Instance.Transparency >= 0.9 then
			table.insert(ign, hit.Instance)
		else
			return false
		end
	end
	return false
end

-- Hedef parçayı bul (Head yoksa HumanoidRootPart, o da yoksa herhangi bir parça)
local function getAimPart(ch)
	if not ch then return nil end
	return ch:FindFirstChild(cfg.Part)
		or ch:FindFirstChild("HumanoidRootPart")
		or ch:FindFirstChild("Torso")
		or ch:FindFirstChild("UpperTorso")
		or ch.PrimaryPart
		or ch:FindFirstChildWhichIsA("BasePart")
end

local function validPlayer(plr)
	if plr == lp then return false end
	if cfg.TeamCheck and plr.Team and plr.Team == lp.Team then return false end
	return true
end

local function candidateDistance(part)
	local mousePos = aimPoint()
	local sp, onScreen = cam:WorldToViewportPoint(part.Position)
	if not onScreen or sp.Z <= 0 then return math.huge end
	return (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
end

local function getTarget()
	local best, bestD = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if not validPlayer(plr) then continue end
		local ch   = plr.Character
		local hum  = ch and ch:FindFirstChildOfClass("Humanoid")
		local part = getAimPart(ch)
		if not (hum and part and hum.Health > 0 and part.Parent) then continue end
		if cfg.WallCheck and not isVisible(part) then continue end
		local d = candidateDistance(part)
		if d <= cfg.FOV and d < bestD then
			best, bestD = part, d
		end
	end
	return best
end

local function keepTarget()
	if not target then return false end
	local plr = Players:GetPlayerFromCharacter(target.Parent)
	if not plr or not validPlayer(plr) then return false end
	local hum = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
	if not (hum and hum.Health > 0 and target.Parent) then return false end
	if cfg.WallCheck and not isVisible(target) then return false end
	return candidateDistance(target) <= cfg.FOV * cfg.StickyFOV
end

----------------------------------------------------------------
-- AIM LOOP
----------------------------------------------------------------
pcall(function() RunService:UnbindFromRenderStep("RzAim") end)
RunService:BindToRenderStep("RzAim", Enum.RenderPriority.Camera.Value + 1, function()
	local ok, err = pcall(function()
		cam = WS.CurrentCamera
		local mousePos = aimPoint()
		circleUpdate(mousePos, cfg.FOV, cfg.ShowCircle)

		updateEsp()

		if not aiming then
			if target then clearHighlight() end
			target = nil
			circleColor(THEME.Accent)
			return
		end

		if not (target and cfg.Sticky and keepTarget()) then
			target = getTarget()
		end

		if not (target and target.Parent) then
			clearHighlight()
			circleColor(THEME.Accent)
			return
		end

		circleColor(THEME.Danger)
		if highlightedChar ~= target.Parent or not highlight then
			setHighlight(target.Parent)
		end

		local aimPos = target.Position
		local hrp = target.Parent:FindFirstChild("HumanoidRootPart") or target
		if cfg.Prediction > 0 and hrp then
			aimPos = aimPos + hrp.AssemblyLinearVelocity * cfg.Prediction
		end

		local goal = CFrame.lookAt(cam.CFrame.Position, aimPos)
		cam.CFrame = cam.CFrame:Lerp(goal, cfg.Smoothing)
	end)
	if not ok then warn("[RZ] Aim error:", err) end
end)

