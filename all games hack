	round(box, 4)
	txt(row, text, UDim2.new(1, -44, 1, 0), UDim2.new(0, 38, 0, 0))
	local on = false
	local function set(v)
		on = v
		box.BackgroundColor3 = v and PUR or OFF
		box.Text = v and "✓" or ""
		if btn then btn.BackgroundColor3 = v and PUR or OFF end
		snd("rbxasset://sounds/switch.wav", .3, v and 1.2 or .9)
		cb(v)
	end
	row.Activated:Connect(function() set(not on) end)
	if btn then btn.Activated:Connect(function() set(not on) end) end
	return set
end

local function slider(parent, text, min, max, key, onChange)
	local h = new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = PAN, BorderSizePixel = 0, Active = true }, parent)
	round(h, 6)
	txt(h, text, UDim2.new(.6, 0, 0, 24), UDim2.new(0, 10, 0, 4))
	local val = txt(h, tostring(S[key]), UDim2.new(.3, 0, 0, 24), UDim2.new(.7, -10, 0, 4), true)
	val.TextXAlignment = Enum.TextXAlignment.Right
	local track = new("Frame", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 34), BackgroundColor3 = OFF, BorderSizePixel = 0 }, h)
	round(track, 3)
	local fill = new("Frame", { BackgroundColor3 = PUR, BorderSizePixel = 0, Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0) }, track)
	round(fill, 3)
	local function setX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		S[key] = math.floor(min + (max - min) * a + .5)
		fill.Size = UDim2.new(a, 0, 1, 0)
		val.Text = tostring(S[key])
		if onChange then onChange(S[key]) end
	end
	local drag = false
	h.InputBegan:Connect(function(i) if isPress(i) then drag = true; setX(i.Position.X) end end)
	UIS.InputChanged:Connect(function(i) if drag and isMove(i) then setX(i.Position.X) end end)
	UIS.InputEnded:Connect(function(i) if isPress(i) then drag = false end end)
end

