-- ===== FLING =====
-- Çarpışma + açısal hız. Anti-fling ve noclip bu sırada karışmaz.
local flinging = false
local FLING_COL = Color3.fromRGB(255, 64, 84)

local function closestByDistance()
	local _, myRoot = parts()
	if not myRoot then return nil end
	local best, bestD = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			local r = plr.Character:FindFirstChild("HumanoidRootPart")
			local h = plr.Character:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health > 0 then
				local d = (r.Position - myRoot.Position).Magnitude
				if d < bestD then bestD, best = d, plr end
			end
		end
	end
	return best
end

local function playerOfPart(part)
	if not part then return nil end
	local model = part.Parent
	if model and model:IsA("Model") then
		local plr = Players:GetPlayerFromCharacter(model)
		if plr then return plr end
	end
	model = part:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model) or nil
end

local function flingOnce(target)
	local myHum, myRoot = parts()
	local char = target and target.Character
	local tRoot = char and char:FindFirstChild("HumanoidRootPart")
	local tHum = char and char:FindFirstChildOfClass("Humanoid")
	if not myHum or not myRoot or not tRoot or not tHum then return false end
	if myHum.Health <= 0 or tHum.Health <= 0 then return false end
	local wasFly = S.flyOn
	if wasFly then stopFlyBody() end
	local origin = myRoot.CFrame
	local pwr = math.clamp(S.flingPower or 50000, 1000, 500000)
	local dur = math.clamp((S.flingMs or 450) / 1000, 0.15, 1.2)
	myHum.Sit = false
	myHum.PlatformStand = true
	pcall(function() myHum:ChangeState(Enum.HumanoidStateType.Physics) end)
	myRoot.Anchored = false
	for _, part in char:GetDescendants() do
		if part:IsA("BasePart") then part.CanCollide = true end
	end
	local bv
	pcall(function()
		bv = new("BodyAngularVelocity", {
			MaxTorque = HUGE,
			AngularVelocity = Vector3.new(pwr, pwr, pwr),
			P = 1e6,
		}, myRoot)
	end)
	snd("rbxasset://sounds/bass.wav", .5, .5)
	local t0 = os.clock()
	while os.clock() - t0 < dur do
		if not myRoot.Parent or not tRoot.Parent or tHum.Health <= 0 then break end
		local me = lp.Character
		if me then
			for _, part in me:GetDescendants() do
				if part:IsA("BasePart") then
					part.CanCollide = true
					part.Massless = false
				end
			end
		end
		myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0.15, 0) * CFrame.Angles(math.rad(90), 0, 0)
		local vel = Vector3.new((math.random() * 2 - 1) * pwr, pwr, (math.random() * 2 - 1) * pwr)
		local spin = Vector3.new(pwr, pwr, pwr)
		myRoot.AssemblyLinearVelocity = vel
		myRoot.AssemblyAngularVelocity = spin
		pcall(function()
			myRoot.Velocity = vel
			myRoot.RotVelocity = spin
		end)
		RS.Heartbeat:Wait()
	end
	if bv and bv.Parent then bv:Destroy() end
	if myRoot.Parent then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
		pcall(function()
			myRoot.Velocity = Vector3.zero
			myRoot.RotVelocity = Vector3.zero
		end)
		myRoot.CFrame = origin
	end
	if myHum.Parent and myHum.Health > 0 then
		myHum.PlatformStand = false
		pcall(function() myHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		if wasFly then flySet(true) end
	end
	return true
end

local function flingPlayer(target)
	if flinging or not target or target == lp then return end
	flinging = true
	task.spawn(function()
		local ok, err = pcall(flingOnce, target)
		if not ok then warn("[ruzgarzorx fling] HATA:", err) end
		task.wait(0.12)
		flinging = false
	end)
end

local function flingAll()
	if flinging then return end
	flinging = true
	task.spawn(function()
		local ok, err = pcall(function()
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= lp and plr.Character then
					flingOnce(plr)
					task.wait(0.15)
				end
			end
		end)
		if not ok then warn("[ruzgarzorx fling] HATA:", err) end
		flinging = false
	end)
end

local function flingLook()
	local plr = playerOfPart(getClosestPlayer(1e6)) or closestByDistance()
	if plr then flingPlayer(plr) end
end

