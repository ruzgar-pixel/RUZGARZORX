	local lin = root.AssemblyLinearVelocity.Magnitude
	local ang = root.AssemblyAngularVelocity.Magnitude
	local linLimit = math.max(500, (S.flyOn and S.flySpeed or 0) * 3, (S.speedOn and S.speed or 0) * 3)
	local angLimit = S.flyOn and 400 or 120

	if lin > linLimit or ang > angLimit then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		if lastSafe then root.CFrame = lastSafe end
	elseif lin < 100 and ang < 20 then
		lastSafe = root.CFrame
	end
end)

