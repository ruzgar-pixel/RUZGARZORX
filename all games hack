local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

local function snd(id, vol, speed)
	local ok, s = pcall(function()
		local x = new("Sound", { SoundId = id, Volume = vol or .6, PlaybackSpeed = speed or 1 }, SoundService)
		x:Play()
		task.delay(6, function() x:Destroy() end)
		return x
	end)
	return ok and s or nil
end

local function worldToScreen(pos)
	local sp, onScreen = cam:WorldToViewportPoint(pos)
	return Vector2.new(sp.X, sp.Y), onScreen, sp.Z
end

-- Hedef arama noktası: PC'de fare, telefonda ekranın ortası
local function aimRef()
	if UIS.MouseEnabled then
		return UIS:GetMouseLocation()
	end
	local vs = cam.ViewportSize
	return Vector2.new(vs.X / 2, vs.Y / 2)
end

local function getClosestPlayer(maxDist)
	local ref = aimRef()
	local closest, shortest = nil, maxDist or S.aimFov
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local part = p.Character:FindFirstChild(S.aimPart)
			if not part and S.aimPart == "UpperTorso" then
				part = p.Character:FindFirstChild("Torso") -- R6 karakterler için
			end
			if hum and hum.Health > 0 and part then
				local screenPos, onScreen, depth = worldToScreen(part.Position)
				if onScreen and depth > 0 then
					local dist = (ref - screenPos).Magnitude
					if dist < shortest then
						shortest = dist
						closest = part
					end
				end
			end
		end
	end
	return closest
end

