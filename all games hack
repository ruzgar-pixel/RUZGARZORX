-- Ana döngü (hız, zıplama, uçma)
RS.RenderStepped:Connect(function()
	local hum, root = parts()
	if not hum or not root then return end
	if S.speedOn then hum.WalkSpeed = S.speed end
	if S.jumpOn then hum.UseJumpPower = true; hum.JumpPower = S.jump end
	if not S.flyOn then return end

	if hum.Health <= 0 then
		flySet(false)
		return
	end
	if not flyBV or not flyBG or flyBV.Parent ~= root then return end

	hum.PlatformStand = true
	local cf = cam.CFrame
	local dir = Vector3.zero
	local typing = UIS:GetFocusedTextBox() ~= nil

	if not typing then
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
	end

	if dir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
		dir = hum.MoveDirection
		local look = cf.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > .01 then
			dir += Vector3.yAxis * (dir:Dot(flat.Unit) * look.Y / flat.Magnitude)
		end
	end

	if not typing then
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
	end
	if up then dir += Vector3.yAxis end
	if down then dir -= Vector3.yAxis end

	flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * S.flySpeed or Vector3.zero
	flyBG.CFrame = cf
end)

