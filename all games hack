local function tpTo(x, y)
	local c = workspace.CurrentCamera
	local _, root = parts()
	if not c or not root then return end
	local ray = c:ScreenPointToRay(x, y)
	local ignore = {}
	if lp.Character then table.insert(ignore, lp.Character) end
	if airPlat then table.insert(ignore, airPlat) end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local res = workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
	if res then
		root.CFrame = CFrame.new(res.Position + Vector3.new(0, 4, 0)) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
		if S.airOn and airPlat then airY = res.Position.Y - .5 end
	end
end
