-- FOV: kendi değerimizi uygular, başka script değiştirirse anında geri yazar
local fovConn
local function applyFov()
	local c = workspace.CurrentCamera
	if not c then return end
	local v = math.clamp(S.fov, 40, 120)
	if c.FieldOfView ~= v then c.FieldOfView = v end
end
local function hookCamera()
	cam = workspace.CurrentCamera
	if fovConn then fovConn:Disconnect() fovConn = nil end
	if cam then
		fovConn = cam:GetPropertyChangedSignal("FieldOfView"):Connect(applyFov)
	end
	applyFov()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
hookCamera()
RS:BindToRenderStep("RuzgarFOV", Enum.RenderPriority.Last.Value, applyFov)

